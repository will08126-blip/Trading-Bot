# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel IDs (right-click channel → Copy ID with Developer Mode on)
ENTRY_CHANNEL_ID=123456789012345678
EXIT_CHANNEL_ID=123456789012345679

# Your Discord user ID (right-click yourself → Copy ID)
# Only reactions from this user trigger trade confirmation
TRADER_USER_ID=123456789012345680

# ── Binance ───────────────────────────────────────────────────────────────────
# Optional — only needed if you hit rate limits on the public API
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ── Bot Settings ─────────────────────────────────────────────────────────────
# How often the scanner checks for signals (seconds)
SCAN_INTERVAL_SECONDS=60

# Minimum score to post an entry signal (0-100). Default=40 (MEDIUM tier)
MIN_SIGNAL_SCORE=40

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
