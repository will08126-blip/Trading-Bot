FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /app/data/models /app/data/historical /app/logs /app/config

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Default to paper mode; override with BOT_MODE env var
CMD ["python", "-m", "app.main", "--mode", "paper"]
