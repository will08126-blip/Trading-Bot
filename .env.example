# ============================================================
# TRADING BOT - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Deployment Mode ----
# Options: live | paper | backtest
BOT_MODE=paper

# ---- Coinbase Advanced API ----
# Generate API keys at: https://www.coinbase.com/settings/api
# For futures, ensure keys have appropriate permissions.
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here
# Optional: if using passphrase-based auth (legacy)
COINBASE_API_PASSPHRASE=

# Coinbase API base URLs (override for sandbox/testing)
COINBASE_REST_URL=https://api.coinbase.com
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# ---- Database ----
DATABASE_URL=sqlite:///./data/trading_bot.db

# ---- Dashboard Auth ----
# Change these before deploying!
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme_strong_password
JWT_SECRET_KEY=change_this_to_a_random_secret_key_32_chars_min

# ---- Discord Notifications ----
# Create a webhook in your Discord server settings
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# ---- Anthropic / Claude API ----
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-4-6

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- ML Models ----
ML_MODEL_DIR=./data/models

# ---- Historical Data Cache ----
DATA_CACHE_DIR=./data/historical

# ---- Paper Trading ----
PAPER_INITIAL_BALANCE=10000.0

# ---- Misc ----
# Worker concurrency / async settings
MAX_CONCURRENT_REQUESTS=10
